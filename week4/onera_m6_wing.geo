Point(2137) = {1.13498200, 1.19630000, -0.00123466};
Point(2138) = {1.13727282, 1.19630000, -0.00093497};
Point(2139) = {1.13921226, 1.19630000, -0.00068124};
Point(2140) = {1.14085415, 1.19630000, -0.00046644};
Point(2141) = {1.14224448, 1.19630000, -0.00028454};
Point(2142) = {1.14342192, 1.19630000, -0.00013049};
Spline(2001) = {2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026, 2027, 2028, 2029, 2030, 2031, 2032, 2033, 2034, 2035, 2036, 2037, 2038, 2039, 2040, 2041, 2042, 2043, 2044, 2045, 2046, 2047, 2048, 2049, 2050, 2051, 2052, 2053, 2054, 2055, 2056, 2057, 2058, 2059, 2060, 2061, 2062, 2063, 2064, 2065, 2066, 2067, 2068, 2069, 2070, 2071, 2072};   // upper TE->LE
Spline(2002) = {2072, 2073, 2074, 2075, 2076, 2077, 2078, 2079, 2080, 2081, 2082, 2083, 2084, 2085, 2086, 2087, 2088, 2089, 2090, 2091, 2092, 2093, 2094, 2095, 2096, 2097, 2098, 2099, 2100, 2101, 2102, 2103, 2104, 2105, 2106, 2107, 2108, 2109, 2110, 2111, 2112, 2113, 2114, 2115, 2116, 2117, 2118, 2119, 2120, 2121, 2122, 2123, 2124, 2125, 2126, 2127, 2128, 2129, 2130, 2131, 2132, 2133, 2134, 2135, 2136, 2137, 2138, 2139, 2140, 2141, 2142, 2001};   // lower LE->TE
Curve Loop(2) = {2001, 2002};

// ---------------- wing solid (ruled: straight generators between root and tip)
Ruled ThruSections(1) = {1, 2};

// ---------------- half-domain box with the wing removed
Box(2) = {-XUP, 0, -ZEXT, XUP + XDN, YEXT, 2*ZEXT};
BooleanDifference(3) = { Volume{2}; Delete; }{ Volume{1}; Delete; };

e = 1e-4;
wing()      = Surface In BoundingBox{-e, -e, -0.1, 1.144419+e, 1.1963+e, 0.1};
wingEdges() = Curve In BoundingBox{-e, -e, -0.1, 1.144419+e, 1.1963+e, 0.1};
symmetry()  = Surface In BoundingBox{-XUP-e, -e, -ZEXT-e, XDN+e, e, ZEXT+e};
inlet()     = Surface In BoundingBox{-XUP-e, -e, -ZEXT-e, -XUP+e, YEXT+e, ZEXT+e};
outlet()    = Surface In BoundingBox{XDN-e, -e, -ZEXT-e, XDN+e, YEXT+e, ZEXT+e};
farTop()    = Surface In BoundingBox{-XUP-e, -e, ZEXT-e, XDN+e, YEXT+e, ZEXT+e};
farBot()    = Surface In BoundingBox{-XUP-e, -e, -ZEXT-e, XDN+e, YEXT+e, -ZEXT+e};
farSide()   = Surface In BoundingBox{-XUP-e, YEXT-e, -ZEXT-e, XDN+e, YEXT+e, ZEXT+e};

Physical Surface("wing", 1)     = wing();
Physical Surface("symmetry", 2) = symmetry();
Physical Surface("inlet", 3)    = inlet();
Physical Surface("outlet", 4)   = outlet();
Physical Surface("farfield", 5) = {farTop(), farBot(), farSide()};
Physical Volume("fluid", 10)    = {3};

// ---------------- size fields: fine at LE/TE, medium on the wing, coarse far away
Field[1] = Distance;  Field[1].CurvesList = {wingEdges()};  Field[1].Sampling = 400;
Field[2] = Threshold; Field[2].InField = 1; Field[2].SizeMin = lc_edge; Field[2].SizeMax = lc_far;
Field[2].DistMin = 0.005; Field[2].DistMax = 3.0;
Field[3] = Distance;  Field[3].SurfacesList = {wing()};  Field[3].Sampling = 100;
Field[4] = Threshold; Field[4].InField = 3; Field[4].SizeMin = lc_wing; Field[4].SizeMax = lc_far;
Field[4].DistMin = 0.02; Field[4].DistMax = 4.0;
Field[5] = Min; Field[5].FieldsList = {2, 4};
Background Field = 5;

Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.MeshSizeFromPoints = 0;
Mesh.MeshSizeFromCurvature = 0;
Mesh.Algorithm = 6;       // Frontal-Delaunay (surfaces)
Mesh.Algorithm3D = 1;     // Delaunay (volume)
Mesh.Optimize = 1;
Mesh.MshFileVersion = 2.2;  // for OpenFOAM gmshToFoam
