/*--------------------------------*- C++ -*----------------------------------*\
  OpenFOAM v2512 (ESI). extrudeMesh puts every side face (airfoil and far-field
  edges) in one patch "sides"; split it by position.
  Airfoil: x 0..0.806, |y| < 0.04. Far field: circle of radius 40 m.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

actions
(
    { name airfoilFaces;  type faceSet; action new;      source patchToFace; patch sides; }
    { name airfoilFaces;  type faceSet; action subset;   source boxToFace;   box (-0.1 -0.1 -1) (0.9 0.1 1); }
    { name farfieldFaces; type faceSet; action new;      source patchToFace; patch sides; }
    { name farfieldFaces; type faceSet; action subtract; source faceToFace;  set airfoilFaces; }
);
