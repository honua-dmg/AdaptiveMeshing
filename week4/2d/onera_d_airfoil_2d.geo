// ONERA D section (ONERA M6 root section, sharp TE) - 2-D test case for Gmsh >= 4.8
// Generated by build_onera_m6_2d.py.   gmsh onera_d_airfoil_2d.geo -2   (EXTRUDE = 0)
//                                       gmsh onera_d_airfoil_2d.geo -3   (EXTRUDE = 1, OpenFOAM)
// Axes: x streamwise, y up, z span (extrusion). Units: metres.
// Reference: M = 0.8395, alpha = 3.06 deg, Re = 1.172e+07 on MAC 0.64607 m -> Re_chord = 1.462e+07

SetFactory("OpenCASCADE");

// ---------------- user parameters
c        = 0.8059;          // chord
R        = 50*c;          // far-field radius
lc_wall  = c/200;         // surface cell size along the airfoil
lc_edge  = c/1000;        // cell size at leading and trailing edge
lc_wake  = c/40;          // cell size in the wake region
lc_far   = 3*c;           // far-field cell size
VISCOUS  = 1;             // 1 = quad boundary layer (RANS), 0 = none (Euler)
bl_first = 1.571e-06;     // first cell height, y+ ~ 1 (flat-plate estimate)
bl_ratio = 1.15;          // growth ratio of BL layers
bl_thick = 0.0143;      // total BL mesh thickness (~1.3 x estimated delta at TE)
EXTRUDE  = 1;             // 1 = one-cell-thick 3-D mesh for OpenFOAM, 0 = pure 2-D
span     = 0.1*c;         // extrusion thickness

